# IANA timezone used to decide where one "play day" ends and the next begins.
TIMEZONE=Europe/London

# --- Database (Turso - SQLite-compatible) ---
# Leave both blank for local development: falls back to a local file at
# ./data/local.db, no external service needed. See docs/DEPLOYMENT.md for
# how to create a Turso database for production.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Screenshot storage (Vercel Blob) ---
# Set automatically in your Vercel deployment once you add Blob storage to
# the project (Vercel dashboard -> Storage -> Create Database -> Blob).
# Screenshot uploads will fail locally until you set this yourself, e.g. by
# pulling it with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# --- Links ---
# The public HTTPS URL this site is deployed at (no trailing slash). Used to
# build links posted into Teams announcements.
PUBLIC_BASE_URL=http://localhost:3000

# --- Teams announcements (optional) ---
# A Teams Incoming Webhook URL, or a Power Automate HTTP-trigger URL that
# relays into a chat/channel. Leave blank to skip announcements entirely -
# the site works fully without this. See docs/DEPLOYMENT.md.
TEAMS_WEBHOOK_URL=

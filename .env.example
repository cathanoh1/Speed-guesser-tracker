# --- Server ---
PORT=3978

# IANA timezone used to decide where one "play day" ends and the next begins.
TIMEZONE=Europe/London

# Where the SQLite database file lives. The directory is created if missing.
DB_PATH=./data/scores.db

# Public HTTPS URL this service is reachable at once deployed (no trailing
# slash). Used to build the "open full leaderboard" link posted into Teams,
# and as the base URL for the Teams tab. See docs/DEPLOYMENT.md.
PUBLIC_BASE_URL=http://localhost:3978

# --- Bot Framework / Microsoft Teams app registration ---
# Created in Azure - see docs/DEPLOYMENT.md for exact steps.
MicrosoftAppType=MultiTenant
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=

# --- Screenshot reading ---
# Anthropic API key used to read scores off submitted screenshots.
# Leave blank to run without screenshot parsing - players can still log
# scores with the `score <game> <points>` text command.
ANTHROPIC_API_KEY=

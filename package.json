{
  "name": "speed-guesser-tracker",
  "version": "1.0.0",
  "description": "Tracks daily TimeGuesser and Speed Quiz scores submitted as screenshots in a Microsoft Teams group chat, shows who still needs to play, crowns daily winners (and Grand Slams), and publishes a shared leaderboard.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-icons": "node scripts/generate-icons.mjs",
    "package-teams-app": "node scripts/package-teams-app.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cathanoh1/speed-guesser-tracker.git"
  },
  "keywords": [
    "microsoft-teams",
    "bot-framework",
    "timeguesser",
    "leaderboard"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cathanoh1/speed-guesser-tracker/issues"
  },
  "homepage": "https://github.com/cathanoh1/speed-guesser-tracker#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "better-sqlite3": "^13.0.3",
    "botbuilder": "^4.23.3",
    "botframework-connector": "^4.23.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
